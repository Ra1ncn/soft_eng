{
  "name": "quiz-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n server,client \"npm run dev -w server\" \"npm run dev -w client\"",
    "predev": "prisma generate",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretypecheck": "prisma generate",
    "test": "vitest run",
    "pretest": "prisma generate",
    "build": "npm run typecheck && npm run build -w client",
    "prisma:generate": "prisma generate",
    "db:seed": "prisma generate && tsx server/prisma/seed.ts"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "dotenv": "^17.2.3",
    "@types/node": "^26.0.0",
    "supertest": "^7.1.4",
    "@types/supertest": "^6.0.3"
  }
}
